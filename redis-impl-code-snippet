4. Implementation (DAO/Service Layer)
    @Repository
    public interface UserRepository extends JpaRepository<User, Long> {}

    Service Layer (with Caching): Use @Cacheable to store results, @CachePut to update, and @CacheEvict to remove entries.

    @Service
    public class UserService {
        @Autowired
        private UserRepository userRepository;

        // Caches the result using 'users' as cache name and user id as key
        @Cacheable(value = "users", key = "#id")
        public User getUserById(Long id) {
            // This method is only executed if the result is not in Redis
            return userRepository.findById(id).orElseThrow();
        }

        // Updates the cache whenever a user is updated
        @CachePut(value = "users", key = "#user.id")
        public User updateUser(User user) {
            return userRepository.save(user);
        }

        // Removes the user from cache when deleted from DB
        @CacheEvict(value = "users", key = "#id")
        public void deleteUser(Long id) {
            userRepository.deleteById(id);
        }
    }
